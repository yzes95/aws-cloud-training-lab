# Application Settings
APP_NAME="AWS Cloud Training Lab"
APP_ENV="development"
DEBUG=true

# AWS Region
AWS_REGION="us-east-1"

# LocalStack endpoint (optional - leave commented out to talk to real AWS)
# LOCALSTACK_ENDPOINT_URL="http://localhost:4566"

# Resources
TRAINING_S3_BUCKET="my-training-s3-bucket"
CLOUDWATCH_LOG_GROUP="/aws/training-lab/fastapi"
