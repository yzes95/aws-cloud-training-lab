# AWS Cloud Training Lab - Environment Configuration
APP_NAME="AWS Cloud Training Lab"
APP_ENV="development"
DEBUG=true

# AWS Configuration
# Set AWS_MOCK_MODE=true to train offline for FREE (no AWS account or costs needed)
# Set AWS_MOCK_MODE=false to connect to real AWS or LocalStack
AWS_MOCK_MODE=true
AWS_REGION="us-east-1"

# Real AWS Credentials (ONLY needed if AWS_MOCK_MODE=false)
# NEVER commit real credentials to GitHub!
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
AWS_SESSION_TOKEN=""

# LocalStack endpoint (if using LocalStack via docker-compose)
# LOCALSTACK_ENDPOINT_URL="http://localhost:4566"
LOCALSTACK_ENDPOINT_URL=""

# S3 Training Bucket
TRAINING_S3_BUCKET="aws-training-lab-bucket"

# CloudWatch Training Log Group
CLOUDWATCH_LOG_GROUP="/aws/training-lab/fastapi"
